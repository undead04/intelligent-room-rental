PROJECT_NAME="Smart Housing Decision Support System API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
SECRET_KEY="dev_secret_key_change_in_production"
ENVIRONMENT="development"
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]

# Security & Rate Limiting
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_ENABLED=true
SQL_INJECTION_CHECK_ENABLED=true

# Embedding Model Configuration
EMBEDDING_MODEL_NAME="intfloat/multilingual-e5-base"
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32

# PostgreSQL Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_postgres_password"
POSTGRES_DB="smart_housing_db"

# Direct Database URL override (Optional)
# DATABASE_URL="postgresql://postgres:your_postgres_password@localhost:5432/smart_housing_db"

# PostgreSQL Connection Pool Configuration
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
